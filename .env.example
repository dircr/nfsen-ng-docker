# nfsen-ng-docker configuration
# copy to .env and adjust:  cp .env.example .env

# Timezone for all containers
TZ=Europe/Warsaw

# Host ports (Caddy)
HTTP_PORT=8080
HTTPS_PORT=8443

# Host address the UI binds to. 127.0.0.1 = this machine only (default).
# Use 0.0.0.0 or a specific LAN address to reach the UI from other hosts —
# and put it behind a firewall. See "Security" in README.md.
WEB_BIND_ADDR=127.0.0.1

# Host address the flow collectors listen on. 0.0.0.0 so routers can reach
# them; narrow it to the LAN address the routers use when possible.
FLOW_BIND_ADDR=0.0.0.0

# Host UDP port range for the flow collectors. Maps to container ports
# 9000-9099, which are the ports used in conf/sources.conf.
UDP_PORT_RANGE=9000-9099

# Caddy basic auth
# Generate the password hash once with:
#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password' | sed 's/\$/\$\$/g'
# and paste the result below. The sed step doubles the $ signs — docker
# compose interpolates $ in .env, so a raw bcrypt hash would be corrupted.
AUTH_USER=admin
AUTH_PASS_HASH=REPLACE_WITH_GENERATED_HASH

# Optional: public domain for Let's Encrypt certificates.
# Also remove the "tls internal" line from caddy/Caddyfile, then:
#   docker compose up -d
# DOMAIN=nfsen.example.com

# Flow data retention (nfdump): nfcapd files older than this many days are
# deleted by nfexpire (once at startup, then hourly). 0 disables expiry.
FLOW_RETENTION_DAYS=30

# nfsen-ng 1.x (UI) -----------------------------------------------------------

# Years of nfcapd history the import daemon walks on start-up (default 3).
NFSEN_IMPORT_YEARS=3

# Days of per-interval top-N data the UI keeps in the state SQLite store for
# the Overview tables; budget ~12 MB per source and day. 0 disables it.
NFSEN_TOPN_RETENTION_DAYS=31

# Service ports offered in the per-port views (comma-separated). Not the
# collector ports from conf/sources.conf — these are the service ports the
# flows use, e.g. 80,443,22,53.
NFSEN_PORTS=80,443,22,53

# DEBUG, INFO, NOTICE, WARNING, ERR, CRIT, ALERT, EMERG
NFSEN_LOG_LEVEL=info

# Container stdout (docker json-file driver): max size per log file and
# number of files kept per container.
LOG_MAX_SIZE=10m
LOG_MAX_FILES=5

# CPU budget per container, in cores (fractions allowed: 0.5, 1.5). Memory and
# PID limits stay fixed in docker-compose.yaml.
#
#   caddy  — TLS termination and basic auth. Every rejected request costs one
#            bcrypt verification (~1 s at cost 14, see AUTH_PASS_HASH), so this
#            is the number that decides how hard a password-guessing flood can
#            bite. One core serves ~1 unauthenticated attempt per second.
#   nfsen  — one process does page rendering, the import daemon, the top-N
#            collector and the SSE stream. This is the one to raise when the
#            import falls behind on many sources.
#   nfdump — collectors only; they are not CPU-hungry, keep it small.
CADDY_CPUS=1.0
NFSEN_CPUS=2.0
NFDUMP_CPUS=1.0

# Only needed when DOMAIN is a bare IP address (LAN deployment without DNS):
# browsers send no SNI for IP literals, so Caddy cannot choose a certificate
# and the connection dies with "tlsv1 alert internal error". Set this to that
# same IP, e.g. CADDY_DEFAULT_SNI=10.0.0.171. Ignored when a hostname is used.
# CADDY_DEFAULT_SNI=10.0.0.171
