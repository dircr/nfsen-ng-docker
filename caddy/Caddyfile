# Caddyfile for nfsen-ng-docker
#
# Default: self-signed TLS (tls internal) — works out of the box.
# For a public domain with Let's Encrypt:
#   1. set DOMAIN=nfsen.example.com in .env
#   2. remove the "tls internal" line below
#   3. docker compose up -d
#
# nfsen-ng 1.x serves the UI *and* its static assets itself (php-via on
# OpenSwoole, port 9000) and Brotli-compresses them, so this proxy adds TLS,
# basic auth, the access log and security headers — no compression, no static
# file handling.

# Global options — first block in the file.
{
	# Caddy answers HTTP requests for the site's own hostname with a built-in 308
	# to https://<host>/, i.e. port 443. This stack publishes HTTPS_PORT (8443
	# by default), so that redirect lands on a port where nothing listens. The
	# :80 site below does the same job but knows the published port; disabling
	# the built-in one makes that block the only redirect (certificate
	# automation is unaffected).
	auto_https disable_redirects

	# No admin API. It listens on localhost inside this container (not published,
	# so not reachable from the LAN or from sibling containers) but it needs no
	# authentication at all: anyone who ever gets into this network namespace —
	# --network host, a published 2019, a debug sidecar — can rewrite the whole
	# proxy config. It also logged a line every 30 s for the healthcheck. The
	# healthcheck now probes :80 instead.
	#
	# Consequence: `caddy reload` no longer works — a config change needs
	# `docker compose up -d --force-recreate caddy` (which is the reliable path
	# anyway, see the stale-mount note in README).
	admin off

	# Certificate to present when the client sends no SNI. Browsers do not send
	# SNI for a bare IP address, so with `DOMAIN` set to an IP (LAN deployment
	# without DNS) Caddy cannot pick a certificate and the handshake fails with
	# "tlsv1 alert internal error". Set CADDY_DEFAULT_SNI to that IP in .env.
	# Harmless otherwise: with a hostname, SNI is always present.
	default_sni {$CADDY_DEFAULT_SNI:localhost}

	# HTTP/3 off: Caddy advertises ``alt-svc: h3=":443"`` using its *listener*
	# port, but the host publishes 8443/tcp only — no UDP at all. Browsers would
	# try QUIC on a port that is both unpublished and closed, then fall back.
	# Rather than advertise something that cannot work (or add a UDP mapping
	# just to satisfy the header), serve HTTP/1.1 + HTTP/2 only. To get HTTP/3
	# back: publish 8443/udp and set HTTPS_PORT=443, then drop this block.
	servers {
		protocols h1 h2
	}
}

{$DOMAIN:localhost} {
	tls internal

	# Access log (JSON), for the fail2ban recipe in README.md. Written to
	# /data (= ./caddy-data on the host, already mounted and gitignored), so
	# no extra volume is needed; Caddy rotates it by size. A site-level log
	# directive keeps startup/error logs on stderr (docker compose logs) —
	# the global "log" option would redirect those to the file as well.
	log {
		output file /data/access.log {
			roll_size 10MB
			roll_keep 5
			roll_keep_for 168h
		}
		format json
	}

	# basic auth — generate the hash once with:
	#   docker run --rm caddy:2 caddy hash-password --plaintext 'your-password'
	# and put the result into AUTH_PASS_HASH in .env
	basic_auth {
		{$AUTH_USER} {$AUTH_PASS_HASH}
	}

	header {
		-Server
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Cross-Origin-Opener-Policy same-origin
		Cross-Origin-Resource-Policy same-origin
		X-Robots-Tag "noindex, nofollow"
		Permissions-Policy "geolocation=(), camera=(), microphone=(), payment=(), usb=(), serial=(), interest-cohort=()"

		# Enforced, and cannot break this app: the UI loads no plugins, has no
		# <base>, and posts no forms to other origins. Small but free.
		Content-Security-Policy "object-src 'none'; base-uri 'self'; form-action 'self'"

		# Full policy, report-only until the browser console is clean (README
		# "Content-Security-Policy" has the flip procedure). The UI renders
		# inline <script type="module"> blocks and an importmap, so
		# 'unsafe-inline' for scripts is unavoidable without app changes — what
		# this still buys once enforced: no third-party script origins, no
		# exfiltration to any other host (connect-src/img-src/form-action), no
		# <object>, no <base> hijack.
		Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; media-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'"
	}

	# HSTS only for a real hostname: on localhost it protects nothing and would
	# pin a self-signed certificate for a year. includeSubDomains/preload are
	# omitted on purpose — neither is undoable in practice.
	@realhost not host localhost 127.0.0.1 [::1]
	header @realhost Strict-Transport-Security "max-age=31536000"

	# The UI pushes live updates over Server-Sent Events; -1 makes Caddy flush
	# each chunk as it arrives instead of buffering the stream.
	reverse_proxy nfsen:9000 {
		flush_interval -1
	}
}

# Plain HTTP → HTTPS. The target port is the one published on the host
# (HTTPS_PORT, set through the compose environment), not the container's 443:
# with non-privileged host ports (8080/8443 by default, needed on rootless
# daemons) a redirect to :443 would go nowhere. ":443" is appended only when
# it is the published port, where the explicit port is harmless.
:80 {
	redir https://{$DOMAIN:localhost}:{$HTTPS_PORT}{uri} permanent
}
